# Room Sync EARLY ALPHA - include inside your existing HTTPS server{}.
# Use a valid public TLS certificate. Homey API secrets remain on private host.
# Change PRIVATE_LINUX_HOST and certificate trust path to match deployment.
# Read-only inventory and bounded diagnostics POST only.

location = /api/homey-room-sync/v1/inventory {
    limit_except GET { deny all; }
    proxy_pass https://PRIVATE_LINUX_HOST:8443;
    proxy_ssl_trusted_certificate /path/to/internal-server-ca.pem;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 1;
    proxy_ssl_name PRIVATE_LINUX_SERVER_CERT_HOSTNAME;
    proxy_ssl_server_name on;
    proxy_http_version 1.1;
    proxy_set_header X-Room-Sync-Key $http_x_room_sync_key;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_connect_timeout 6s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;
    access_log off;
    add_header Cache-Control "private, no-store" always;
}
location = /api/homey-room-sync/v1/diagnostics {
    limit_except POST { deny all; }
    client_max_body_size 40k;
    proxy_pass https://PRIVATE_LINUX_HOST:8443;
    proxy_ssl_trusted_certificate /path/to/internal-server-ca.pem;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 1;
    proxy_ssl_name PRIVATE_LINUX_SERVER_CERT_HOSTNAME;
    proxy_ssl_server_name on;
    proxy_http_version 1.1;
    proxy_set_header X-Room-Sync-Key $http_x_room_sync_key;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_connect_timeout 6s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;
    access_log off;
    add_header Cache-Control "private, no-store" always;
}
